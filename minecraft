#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER_DIR="$SCRIPT_DIR/minecraft-1.20.1-server"
PAPER_JAR="paper-1.20.1.jar"
PAPER_URL="https://api.papermc.io/v2/projects/paper/versions/1.20.1/builds/176/downloads/paper-1.20.1-176.jar"
PLUGIN_DIR="$SERVER_DIR/plugins"
PLUGIN_BUILD_DIR="$SCRIPT_DIR/daylength-plugin"
PLUGIN_JAR_NAME="daylength-plugin.jar"

print_help() {
  cat <<'HELP'
  Uso:
    ./minecraft init            - Crea el servidor Paper 1.20.1 y prepara el plugin de día de 3 horas
    ./minecraft build-plugin    - Compila el plugin si tienes JDK instalado
    ./minecraft start           - Inicia el servidor
    ./minecraft status          - Verifica el estado del servidor
    ./minecraft help            - Muestra esta ayuda

  El servidor usa Paper 1.20.1 y coloca el plugin en:
    $SERVER_DIR/plugins/$PLUGIN_JAR_NAME

  Notas:
    - Para que el plugin funcione necesitas Java 17 o superior.
    - Si no tienes compilador Java, instala JDK 17+ y ejecuta:
        ./minecraft build-plugin
    - Si ya tienes el plugin jar compilado, colócalo en:
        $SERVER_DIR/plugins/$PLUGIN_JAR_NAME
HELP
}

ensure_java() {
  if ! command -v java >/dev/null 2>&1; then
    echo "ERROR: No se encontró Java. Instala Java 17 o superior." >&2
    exit 1
  fi
}

download_file() {
  local url="$1"
  local dest="$2"

  if command -v curl >/dev/null 2>&1; then
    curl -L --fail -o "$dest" "$url"
    return
  fi
  if command -v wget >/dev/null 2>&1; then
    wget -O "$dest" "$url"
    return
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - <<PY
import sys, urllib.request
url = sys.argv[1]
dest = sys.argv[2]
req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
with urllib.request.urlopen(req) as r:
    data = r.read()
with open(dest, 'wb') as f:
    f.write(data)
PY
  else
    echo "ERROR: No se encontró curl, wget ni python3 para descargar archivos." >&2
    return 1
  fi
}

create_server() {
  mkdir -p "$SERVER_DIR"
  mkdir -p "$PLUGIN_DIR"

  cat > "$SERVER_DIR/eula.txt" <<EULA
# Este archivo se genera automáticamente.
eula=true
EULA

  cat > "$SERVER_DIR/server.properties" <<PROPS
motd=Servidor Minecraft 1.20.1 - Día 3 horas
server-port=25565
online-mode=false
allow-flight=false
spawn-protection=0
max-players=10
enable-command-block=true
pvp=true
difficulty=easy
gamemode=survival
level-name=world
level-type=default
generate-structures=true
spawn-animals=true
spawn-npcs=true
spawn-monsters=true
view-distance=8
enable-rcon=false
enable-query=false
enable-status=true
motd=Servidor 1.20.1 con día de 3 horas reales
PROPS

  cat > "$SERVER_DIR/start.sh" <<'START'
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
if [ ! -f "paper-1.20.1.jar" ]; then
  echo "ERROR: No se encontró paper-1.20.1.jar. Ejecuta ./minecraft init primero." >&2
  exit 1
fi
java -Xms1G -Xmx2G -jar "paper-1.20.1.jar" nogui
START
  chmod +x "$SERVER_DIR/start.sh"

  echo "Servidor creado en: $SERVER_DIR"
  echo "Descargando Paper 1.20.1..."
  if [ ! -f "$SERVER_DIR/$PAPER_JAR" ]; then
    download_file "$PAPER_URL" "$SERVER_DIR/$PAPER_JAR"
  else
    echo "Paper ya existe en $SERVER_DIR/$PAPER_JAR"
  fi

  if [ -f "$PLUGIN_BUILD_DIR/$PLUGIN_JAR_NAME" ]; then
    cp "$PLUGIN_BUILD_DIR/$PLUGIN_JAR_NAME" "$PLUGIN_DIR/$PLUGIN_JAR_NAME"
    echo "Plugin instalado en $PLUGIN_DIR/$PLUGIN_JAR_NAME"
  else
    echo "Plugin no compilado aún. Ejecuta ./minecraft build-plugin cuando tengas JDK instalado."
  fi
}

build_plugin() {
  if [ ! -d "$PLUGIN_BUILD_DIR" ]; then
    echo "ERROR: No se encontró el directorio de plugin $PLUGIN_BUILD_DIR." >&2
    exit 1
  fi
  if [ ! -f "$SERVER_DIR/$PAPER_JAR" ]; then
    echo "ERROR: Debes inicializar el servidor primero con ./minecraft init." >&2
    exit 1
  fi
  if ! command -v javac >/dev/null 2>&1; then
    echo "ERROR: No se encontró javac. Instala JDK 17+ para compilar el plugin." >&2
    exit 1
  fi
  if ! command -v jar >/dev/null 2>&1; then
    echo "ERROR: No se encontró jar. Instala JDK 17+ para compilar el plugin." >&2
    exit 1
  fi

  local build_dir="$PLUGIN_BUILD_DIR/build"
  rm -rf "$build_dir"
  mkdir -p "$build_dir/classes"

  javac -classpath "$SERVER_DIR/$PAPER_JAR" -d "$build_dir/classes" \
    "$PLUGIN_BUILD_DIR/src/main/java/com/example/daylength/DayLengthPlugin.java"

  jar cf "$PLUGIN_BUILD_DIR/$PLUGIN_JAR_NAME" -C "$build_dir/classes" com
  jar uf "$PLUGIN_BUILD_DIR/$PLUGIN_JAR_NAME" -C "$PLUGIN_BUILD_DIR" plugin.yml

  mkdir -p "$PLUGIN_DIR"
  cp "$PLUGIN_BUILD_DIR/$PLUGIN_JAR_NAME" "$PLUGIN_DIR/$PLUGIN_JAR_NAME"
  echo "Plugin compilado e instalado en $PLUGIN_DIR/$PLUGIN_JAR_NAME"
}

start_server() {
  if [ ! -x "$SERVER_DIR/start.sh" ]; then
    echo "ERROR: El servidor no está inicializado. Ejecuta ./minecraft init primero." >&2
    exit 1
  fi
  bash "$SERVER_DIR/start.sh"
}

status_server() {
  if [ ! -d "$SERVER_DIR" ]; then
    echo "Servidor no inicializado." >&2
    exit 1
  fi
  echo "Servidor: $SERVER_DIR"
  echo "- Paper jar: $( [ -f "$SERVER_DIR/$PAPER_JAR" ] && echo OK || echo NO )"
  echo "- Plugin jar: $( [ -f "$PLUGIN_DIR/$PLUGIN_JAR_NAME" ] && echo OK || echo NO )"
  echo "- Start script: $( [ -x "$SERVER_DIR/start.sh" ] && echo OK || echo NO )"
}

main() {
  if [ $# -lt 1 ]; then
    print_help
    exit 0
  fi

  case "$1" in
    init)
      ensure_java
      create_server
      ;;
    build-plugin)
      build_plugin
      ;;
    start)
      ensure_java
      start_server
      ;;
    status)
      status_server
      ;;
    help|--help|-h)
      print_help
      ;;
    *)
      echo "Comando desconocido: $1" >&2
      print_help
      exit 1
      ;;
  esac
}

main "$@"
