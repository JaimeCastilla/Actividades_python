#!/usr/bin/env bash
set -euo pipefail

SERVER_DIR="${PWD}/karmaland5-server"
STARTER_JAR="forge-server.jar"
MEMORY_MIN="2G"
MEMORY_MAX="4G"

print_help() {
  cat <<-HELP
  Uso:
    ./minecraft init                  - Crea el servidor base Karmaland5
    ./minecraft install <zip>         - Extrae un paquete ZIP de servidor/mods en el servidor
    ./minecraft start                 - Inicia el servidor de Minecraft
    ./minecraft status                - Comprueba el estado del servidor
    ./minecraft help                  - Muestra esta ayuda

  Explicación:
    Este script crea una carpeta de servidor llamada karmaland5-server y genera los archivos
    básicos necesarios para arrancar un servidor Forge. No incluye el modpack de Karmaland 5.
    Para jugar con Karmaland 5, descarga el modpack oficial y usa el comando install.

  Ejemplos:
    ./minecraft init
    ./minecraft install ~/Descargas/karmaland5-server.zip
    ./minecraft start
  HELP
}

ensure_java() {
  if ! command -v java >/dev/null 2>&1; then
    echo "ERROR: Java no está instalado. Instala Java 17 o superior." >&2
    exit 1
  fi
}

create_server() {
  mkdir -p "$SERVER_DIR"
  cat > "$SERVER_DIR/eula.txt" <<EULA
# Generated by minecraft installer script
# Set to true to accept the Minecraft EULA.
eula=true
EULA

  cat > "$SERVER_DIR/server.properties" <<PROPS
# Karmaland 5 server defaults
motd=Servidor Karmaland 5
server-port=25565
enable-command-block=true
max-players=20
level-name=world
enable-jmx-monitoring=false
enable-query=false
enable-rcon=false
allow-nether=true
spawn-animals=true
spawn-npcs=true
spawn-monsters=true
generate-structures=true
online-mode=true
view-distance=8
max-build-height=256
level-type=default
hardcore=false
pvp=true
PROPS

  cat > "$SERVER_DIR/start.sh" <<'START'
#!/usr/bin/env bash
set -euo pipefail
STARTER_JAR="forge-server.jar"
MEMORY_MIN="2G"
MEMORY_MAX="4G"
cd "$(dirname "$0")"
if [ ! -f "$STARTER_JAR" ]; then
  echo "ERROR: No se ha encontrado el archivo de servidor $STARTER_JAR." >&2
  echo "Coloca el jar de Forge/Servidor en $STARTER_JAR dentro de este directorio." >&2
  exit 1
fi
if [ ! -f eula.txt ]; then
  echo "ERROR: No se ha encontrado eula.txt. Ejecuta ./minecraft init primero." >&2
  exit 1
fi
java -Xms$MEMORY_MIN -Xmx$MEMORY_MAX -jar "$STARTER_JAR" nogui
START
  chmod +x "$SERVER_DIR/start.sh"
  echo "Servidor básico creado en: $SERVER_DIR"
  echo "Coloca el jar de servidor de Forge en: $SERVER_DIR/$STARTER_JAR"
}

install_zip() {
  local zip_path="$1"
  if [ ! -f "$zip_path" ]; then
    echo "ERROR: No existe el archivo ZIP especificado: $zip_path" >&2
    exit 1
  fi
  mkdir -p "$SERVER_DIR"
  if command -v unzip >/dev/null 2>&1; then
    unzip -o "$zip_path" -d "$SERVER_DIR"
  else
    echo "ERROR: unzip no está instalado. Instala unzip para usar este comando." >&2
    exit 1
  fi
  echo "Contenido extraído en: $SERVER_DIR"
  echo "Revisa que el jar de Forge y la carpeta mods estén presentes antes de iniciar." 
}

start_server() {
  if [ ! -x "$SERVER_DIR/start.sh" ]; then
    echo "ERROR: El servidor no está inicializado. Ejecuta ./minecraft init primero." >&2
    exit 1
  fi
  bash "$SERVER_DIR/start.sh"
}

status_server() {
  if [ -d "$SERVER_DIR" ]; then
    echo "Servidor configurado en: $SERVER_DIR"
    if [ -f "$SERVER_DIR/$STARTER_JAR" ]; then
      echo "- Jar de servidor presente: $STARTER_JAR"
    else
      echo "- Jar de servidor NO presente: $STARTER_JAR"
    fi
    if [ -d "$SERVER_DIR/mods" ]; then
      echo "- Carpeta mods presente"
    else
      echo "- Carpeta mods NO presente"
    fi
  else
    echo "Servidor no inicializado. Ejecuta ./minecraft init." >&2
    exit 1
  fi
}

main() {
  if [ $# -lt 1 ]; then
    print_help
    exit 0
  fi
  case "$1" in
    init)
      ensure_java
      create_server
      ;;
    install)
      if [ $# -ne 2 ]; then
        echo "Uso: ./minecraft install <ruta-del-zip>" >&2
        exit 1
      fi
      install_zip "$2"
      ;;
    start)
      start_server
      ;;
    status)
      status_server
      ;;
    help|--help|-h)
      print_help
      ;;
    *)
      echo "Comando desconocido: $1" >&2
      print_help
      exit 1
      ;;
  esac
}

main "$@"
